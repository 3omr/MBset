   "number": 3,
   "section": 1,
   "type": "QCS",
   "stem": "Which class of oral diabetes drugs is paired most appropriately with its primary mechanism of action?",
   "options": [
    {
     "letter": "A",
     "text": "DPP-4 inhibitor-inhibits breakdown of complex carbohydrates",
     "bold": 0.0,
     "color": 0.0,
